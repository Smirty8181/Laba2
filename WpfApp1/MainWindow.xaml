<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- Логин -->
        <Label Content="Логин:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"/>
        <TextBox x:Name="LoginTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="100,10,0,0"/>

        <!-- Пароль -->
        <Label Content="Пароль:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0"/>
        <PasswordBox x:Name="PasswordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="100,40,0,0"/>

        <!-- Имя -->
        <Label Content="Имя:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,70,0,0"/>
        <TextBox x:Name="FirstNameTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="100,70,0,0"/>

        <!-- Фамилия -->
        <Label Content="Фамилия:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,100,0,0"/>
        <TextBox x:Name="LastNameTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="100,100,0,0"/>

        <!-- Дата рождения -->
        <Label Content="Дата рождения:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,130,0,0"/>
        <DatePicker x:Name="BirthDatePicker" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="100,130,0,0"/>

        <!-- Наличие образования -->
        <CheckBox x:Name="HasEducationCheckBox" Content="Есть образование" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,160,0,0"/>

        <!-- Образование -->
        <Label Content="Укажите образование:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,190,0,0"/>
        <TextBox x:Name="EducationTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="150,190,0,0" IsEnabled="False"/>

        <!-- Кнопка регистрации -->
        <Button Content="Регистрация" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Margin="0,230,0,0" Click="RegisterButton_Click"/>

    </Grid>
</Window>
